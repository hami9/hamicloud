# ==============================================================================
# HamiCloud Environment Configuration
# ==============================================================================

# Environment mode: development | staging | production
ENVIRONMENT=development

# Control Plane API Configuration
PROJECT_NAME="HamiCloud Control API"
API_V1_PREFIX=/v1

# PostgreSQL Configuration
# Async connection (used by FastAPI / SQLAlchemy asyncpg)
DATABASE_URL=postgresql+asyncpg://hamicloud:hamicloud_secret@localhost:5432/hamicloud
# Sync connection (used by Alembic migration runner)
DATABASE_URL_SYNC=postgresql://hamicloud:hamicloud_secret@localhost:5432/hamicloud

# Redis Configuration (Cache & Token-Bucket Rate Limiter)
REDIS_URL=redis://localhost:6379/0

# NATS JetStream Configuration
NATS_URL=nats://localhost:4222

# S3 / MinIO Object Storage (Job Artifacts & Logs)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET_ARTIFACTS=hamicloud-artifacts
S3_REGION=us-east-1

# Platform Security & Encryption (AES-256-GCM 32-byte Base64 key)
SECRET_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Default Workspace Resource Quotas
DEFAULT_JOB_TIMEOUT_SECONDS=600
DEFAULT_BUILD_TIMEOUT_SECONDS=900
DEFAULT_WORKSPACE_JOB_CONCURRENCY=2
DEFAULT_WORKSPACE_SERVICE_CAP=2
